# Required
MCP_TEST_USER_EMAIL=<USER_EMAIL>
MCP_TEST_USER_PASSWORD=<USER_PASSWORD>
MCP_ORG_ID=<ORG_ID>
MCP_SERVER_URL=https://mcp.saas-qa.beescloud.com/v1/mcp

# Runner (agentic loop) provider: anthropic | bedrock  (default: anthropic)
RUNNER_MODEL_PROVIDER=anthropic

# Eval (deepeval metrics) provider: anthropic | bedrock | gemini  (default: anthropic)
EVAL_MODEL_PROVIDER=anthropic

# --- Anthropic direct ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_ID=claude-sonnet-4-5

# --- AWS Bedrock (runner + eval model) ---
AWS_REGION=<REGION>  # e.g. us-east-1, us-west-2, eu-west-1
AWS_BEDROCK_MODEL_ID=<BEDROCK_MODEL_ID>  # e.g. anthro-claude-v2-100k, anthro-claude-instant-v1, amazon-codewhisperer, amazon-codewhisperer-instant, amazon-codewhisperer-pro, amazon-codewhisperer-pro-instant, amazon-codewhisperer-pro-instant-v2, amazon-codewhisperer-pro-v2, amazon-codewhisperer-v1, amazon-codewhisperer-v2, amazon-codewhisperer-v3, amazon-codewhisperer-v4, amazon-codewhisperer-v5, amazon-codewhisperer-v6, amazon-codewhisperer-v7, amazon-codewhisperer-v8, amazon-codewhisperer-v9, amazon-codewhisperer-v10
AWS_PROFILE=<AWS_PROFILE>  # alternative to access key + secret

# --- Gemini (eval model only) ---
GOOGLE_API_KEY=<GOOGLE_API_KEY>
GEMINI_MODEL_ID=<MODEL_ID>  # e.g. gemini-2.5-flash
